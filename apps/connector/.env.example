# Entorno
NODE_ENV=development

# Conexión al broker del curso (AMQPS/TLS)
RABBITMQ_URL=amqps://observer.45:<password>@broker.iic2173.org:5671/energy

# Cola asignada al observer
RABBITMQ_QUEUE=observer.45.q

# Secreto compartido con master para el POST /events
INTERNAL_TOKEN=change-me-to-a-long-random-secret

# URL del master (ej. http://localhost:3000)
MASTER_URL=http://localhost:3000

# Timeout del reenvío HTTP (ms)
REQUEST_TIMEOUT_MS=5000

# Tope de reintentos del reenvío HTTP
MAX_FORWARD_RETRIES=5
