# Entorno
NODE_ENV=development

# Master API
PORT=3000

# Base de Datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=energy_db
# En producción (RDS) debe ser "true"
DB_SSL=false

# Secreto compartido entre connector y master para el POST /events.
# Generar un valor aleatorio largo (p. ej. `openssl rand -hex 32`) y usarlo en AMBOS servicios.
INTERNAL_TOKEN=change-me-to-a-long-random-secret

# RabbitMQ Connector
# URL de conexión AMQPS provista por el curso
RABBITMQ_URL=amqps://observer.45:<password>@broker.iic2173.org:5671/energy
# Nombre de la cola asignada al grupo
RABBITMQ_QUEUE=observer.45.q

# URL del master (ej. http://master:3000 en red Docker local, o http://localhost:3000)
MASTER_URL=http://localhost:3000

# Timeout del reenvío HTTP (ms)
REQUEST_TIMEOUT_MS=5000

# Tope de reintentos del reenvío HTTP
MAX_FORWARD_RETRIES=5
